# Supabase – Werte unter: Supabase Dashboard → Project Settings → API Keys / Data API
# Kopiere diese Datei nach .env.local und trage deine Werte ein.

# Projekt-URL, z. B. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Öffentlicher Key (sb_publishable_… bzw. alter "anon" Key). Darf in Web & Apps.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Geheimer Key (sb_secret_… bzw. alter "service_role" Key). NUR auf dem Server!
SUPABASE_SECRET_KEY=

# Stripe (Abo & Abrechnung) – Einrichtung siehe docs/STRIPE.md. Ohne Keys läuft die App, Abschluss ist dann nicht möglich.
# Geheimer Key (sk_test_… bzw. sk_live_…). NUR auf dem Server!
STRIPE_SECRET_KEY=
# Signing-Secret des Webhook-Endpunkts /api/v1/billing/webhook (whsec_…)
STRIPE_WEBHOOK_SECRET=
